{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go.flightdeck.dev/schemas/pack.schema.json",
  "title": "Flightdeck Scenario Pack manifest (pack.yaml)",
  "description": "Manifest for a Flightdeck scenario pack. apiVersion packs.flightdeck.dev/v1.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "packs.flightdeck.dev/v1" },
    "kind": { "const": "ScenarioPack" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "license"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^([a-z0-9][a-z0-9-]{0,38}/)?[a-z0-9][a-z0-9-]{0,62}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$" },
        "publisher": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "homepage": { "type": "string" },
        "license": { "type": "string" },
        "tier": { "type": "string", "enum": ["community", "premium", "enterprise"] },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenarioApiVersions": { "type": "array", "items": { "type": "string" } },
            "minLabctlVersion": { "type": "string" }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "type": "array", "items": { "type": "string" } },
            "packs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" }
                }
              }
            }
          }
        },
        "provides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenarios": { "type": "array", "items": { "type": "string" } },
            "incidents": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checksum": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
