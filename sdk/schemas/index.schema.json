{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go.flightdeck.dev/schemas/index.schema.json",
  "title": "Flightdeck Pack Registry index (index.json)",
  "description": "Static catalog of published scenario packs. apiVersion packs.flightdeck.dev/v1, kind PackIndex.",
  "type": "object",
  "required": ["apiVersion", "kind", "entries"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "packs.flightdeck.dev/v1" },
    "kind": { "const": "PackIndex" },
    "generated": { "type": "string", "description": "RFC3339 build time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "ref"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^([a-z0-9][a-z0-9-]{0,38}/)?[a-z0-9][a-z0-9-]{0,62}$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$" },
          "ref": { "type": "string", "pattern": "^(oci://|git\\+https?://).+" },
          "publisher": { "type": "string" },
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "license": { "type": "string" },
          "tier": { "type": "string", "enum": ["community", "premium", "enterprise"] },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "categories": { "type": "array", "items": { "type": "string" } },
          "verified": { "type": "boolean" },
          "digest": { "type": "string" }
        }
      }
    }
  }
}
