# GKE runtime-specific defaults (task 064).
# Loaded by labctl and platform scripts to resolve runtime-specific values.

INGRESS_CLASS=nginx
STORAGE_CLASS=standard-rwo
DOMAIN_SUFFIX=sagarslab.io
REGISTRY_TYPE=gar

# GCP-specific
GCP_PROJECT=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# Artifact Registry repo (gar) for app images
GAR_REPO=sagars-lab
